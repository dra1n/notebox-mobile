#kaocha/v1
{:tests   [{:id           :unit
            :test-paths   ["test"]
            :source-paths ["src" "scripts"]
            :ns-patterns  ["-test$"]}]
 :plugins [:kaocha.plugin/cloverage]
 ;; Per-namespace minimums from the phase gates live in scripts/coverage_gate.clj.
 :cloverage/opts {:custom-report     coverage-gate/report
                  :ns-regex          ["notebox\\..*"]
                  :ns-exclude-regex  []
                  :src-ns-path       ["src"]
                  :output            "target/coverage"
                  :text?             false
                  :summary?          true
                  :html?             true
                  :fail-threshold    0}}
